# MAIA — integración backend (opcional)
# Copia a .env.local y ajusta cuando Diego entregue staging.

# URL base del API real (sin slash final)
# MAIA_API_BASE_URL=https://staging.ejemplo.com/api

# Sin URL → modo demostración (se avisa en pantalla).
# Con URL y MAIA_USE_MOCK distinto de true → solo backend real:
#   si falla, la UI muestra un error con "Reintentar"; NUNCA cae a datos demo.
# MAIA_USE_MOCK=true   # fuerza demostración aunque exista URL

# Rutas relativas al base URL (ajustables al contrato real)
# MAIA_SCREENING_SEARCH_PATH=/screening/search
# MAIA_DECISIONS_FEEDBACK_PATH=/decisions/feedback

# Token Bearer opcional
# MAIA_API_TOKEN=

# Mongo (seed demo opcional — no sustituye el motor)
# MONGODB_URI=
# MONGODB_DB=maia
