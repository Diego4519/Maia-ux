{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": [
    "MAIA_API_BASE_URL",
    "MAIA_API_TOKEN",
    "MAIA_USE_MOCK",
    "MAIA_SCREENING_SEARCH_PATH",
    "MAIA_DECISIONS_FEEDBACK_PATH",
    "MONGODB_URI",
    "MONGODB_DB",
    "NEXT_PUBLIC_MAIA_API_BASE_URL",
    "NEXT_PUBLIC_MAIA_USE_MOCK"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
